# Database Configuration
DATABASE_URL=sqlite:///./whatsapp_mcp.db

# WhatsApp MCP Server Configuration
WHATSAPP_MCP_SERVER_URL=ws://localhost:8001
WHATSAPP_HTTP_URL=http://localhost:8001

# AI Service API Keys (Optional - for enhanced message classification and response generation)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application Settings
DEBUG=True
LOG_LEVEL=INFO

# Security (Optional - for production deployment)
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# External Services (Optional)
REDIS_URL=redis://localhost:6379
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Business Configuration
BUSINESS_NAME=Your Business Name
BUSINESS_PHONE=+1234567890
BUSINESS_EMAIL=contact@yourbusiness.com
BUSINESS_WEBSITE=https://yourbusiness.com
SUPPORT_EMAIL=support@yourbusiness.com
BUSINESS_HOURS=9:00 AM - 6:00 PM

# Feature Flags
ENABLE_AUTO_RESPONSES=True
ENABLE_AI_CLASSIFICATION=True
ENABLE_BROADCAST_MESSAGES=True
ENABLE_ANALYTICS=True